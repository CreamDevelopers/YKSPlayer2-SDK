<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>yks-pack</AssemblyName>
    <RootNamespace>YksPack</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yks-pack</ToolCommandName>
    <PackageId>YKSPlayer.Pack</PackageId>
    <Version>1.0.0</Version>
    <Description>Validate, package and sign YKSPlayer 2 plugins (.ykspkg).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\YKSPlayer.Sdk\YKSPlayer.Sdk.csproj" />
  </ItemGroup>

</Project>
